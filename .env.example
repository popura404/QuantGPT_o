# QuantGPT Environment Configuration
# Copy this file to .env and fill in your values

# LLM — DeepSeek (OpenAI-compatible)
# Optional: leave empty to use expression-only mode (no natural language input)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Database — SQLite (default, zero config) or PostgreSQL
# Leave empty for SQLite (./quantgpt.db), or set PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://quantgpt:your_password@localhost:5433/quantgpt
DATABASE_URL=

# Local development auth bypass
# Only set true for local single-user development. Production must keep false.
AUTH_DISABLED=false
QUANTGPT_ALLOW_GUEST_BACKTEST=false

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_random_64_char_hex_string
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# HTTP MCP endpoints (/mcp, /mcp-sse)
# Required when AUTH_DISABLED=false and exposing HTTP MCP. Generate with: openssl rand -hex 32
QUANTGPT_MCP_HTTP_TOKEN=

# SMTP — Email verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@example.com
SMTP_USE_TLS=true

# Feedback Webhook (optional, Feishu/Lark)
QUANTGPT_FEEDBACK_WEBHOOK=
QUANTGPT_FEEDBACK_WEBHOOK_SECRET=

# RiceQuant (rqdatac) — primary A-share data source (optional)
RQDATAC_USERNAME=
RQDATAC_PASSWORD=

# Admin
# Use a long random password in production.
QUANTGPT_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# App tuning (optional)
QUANTGPT_MAX_ACTIVE_TASKS=100
QUANTGPT_RATE_LIMIT=50
# Keep this to trusted local/private-network origins only.
QUANTGPT_CORS_ORIGINS=http://localhost:5173,http://localhost:8003,http://127.0.0.1:5173,http://127.0.0.1:8003

# Task execution backend: "process" (default, multi-core) or "celery" (distributed) or "thread" (legacy)
QUANTGPT_TASK_BACKEND=process
QUANTGPT_WORKER_PROCESSES=4

# Rust engine: set to 0 to disable (falls back to pure Python)
QUANTGPT_RUST_ENGINE=1

# WorldQuant BRAIN API (optional — enables real WQ alpha submission)
WQ_BRAIN_EMAIL=
WQ_BRAIN_PASSWORD=

# Celery (only needed if QUANTGPT_TASK_BACKEND=celery)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
